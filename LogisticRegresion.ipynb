import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix

# ==========================================
# 1. LOAD DATASET
# ==========================================
# file CSV dataset
url = "Waste_Management_and_Recycling_India.csv"
df = pd.read_csv(url)

print("=== INFORMASI DATASET AWAL ===")
print(f"Jumlah baris dan kolom: {df.shape}")

# Pra-pemrosesan dasar (membersihkan duplikasi dan missing values)
df = df.dropna().drop_duplicates().reset_index(drop=True)

# Memilih fitur numerik dan target biner (2 kelas: Composting vs Landfill)
# Sesuai dengan perhitungan manual sebelumnya
df_filtered = df[df['Disposal Method'].isin(['Composting', 'Landfill'])].copy()
df_filtered['x1'] = df_filtered['Waste Generated (Tons/Day)'] / 1000.0
df_filtered['x2'] = df_filtered['Recycling Rate (%)'] / 100.0
df_filtered['y'] = df_filtered['Disposal Method'].apply(lambda val: 0 if val == 'Composting' else 1)

# ==========================================
# 2. BAGIAN A: 5 DATA LATIH & 1 DATA UJI
# ==========================================
print("\n" + "="*50)
print("BAGIAN A: 5 DATA LATIH DAN 1 DATA UJI")
print("="*50)

# Mengambil 5 data latih (ada kelas 0 dan 1)
train_subset = pd.concat([
    df_filtered[df_filtered['y'] == 0].head(3),
    df_filtered[df_filtered['y'] == 1].head(2)
]).reset_index(drop=True)

# Mengambil 1 data uji
test_subset = df_filtered[df_filtered['y'] == 0].tail(1).reset_index(drop=True)

X_train_5 = train_subset[['x1', 'x2']]
y_train_5 = train_subset['y']

X_test_1 = test_subset[['x1', 'x2']]
y_test_1 = test_subset['y']

print("\n--- 5 DATA LATIH ---")
display(train_subset[['x1', 'x2', 'y', 'Disposal Method']])

print("\n--- 1 DATA UJI ---")
display(test_subset[['x1', 'x2', 'y', 'Disposal Method']])

# Melatih model Regresi Logistik (max_iter=2 untuk simulasi 2 epoch)
model_5data = LogisticRegression(max_iter=2, solver='lbfgs')
model_5data.fit(X_train_5, y_train_5)

# Melakukan prediksi pada 1 data uji
pred_1 = model_5data.predict(X_test_1)
prob_1 = model_5data.predict_proba(X_test_1)

print(f"\nHasil Prediksi Kelas untuk Data Uji: Kelas {pred_1[0]} ('Composting' jika 0, 'Landfill' jika 1)")
print(f"Probabilitas Prediksi: {prob_1[0]}")


# ==========================================
# 3. BAGIAN B: SEMUA DATA DENGAN PEMBAGIAN 80%:20%
# ==========================================
print("\n" + "="*50)
print("BAGIAN B: KLASIFIKASI SEMUA DATA (80% LATIH : 20% UJI)")
print("="*50)

X_all = df_filtered[['x1', 'x2']]
y_all = df_filtered['y']

# Splitting data 80% training dan 20% testing
X_train_full, X_test_full, y_train_full, y_test_full = train_test_split(
    X_all, y_all, test_size=0.2, random_state=42
)

print(f"Jumlah Data Latih (80%): {X_train_full.shape[0]} baris")
print(f"Jumlah Data Uji (20%): {X_test_full.shape[0]} baris")

# Melatih model Regresi Logistik penuh
model_full = LogisticRegression(max_iter=100, solver='lbfgs')
model_full.fit(X_train_full, y_train_full)

# Evaluasi model
y_pred_full = model_full.predict(X_test_full)
akurasi = accuracy_score(y_test_full, y_pred_full)

print(f"\nAkurasi Model pada Data Uji (20%): {akurasi * 100:.2f}%")
print("\nConfusion Matrix:")
print(confusion_matrix(y_test_full, y_pred_full))
print("\nClassification Report:")
print(classification_report(y_test_full, y_pred_full, target_names=['Composting (0)', 'Landfill (1)']))
